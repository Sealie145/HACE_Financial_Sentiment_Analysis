# HACE environment variables — copy to .env and fill in values

# Random seed for reproducibility
HACE_SEED=42

# Model base
FINBERT_MODEL_NAME=ProsusAI/finbert

# Data paths (override defaults if needed)
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed
# MODELS_DIR=models
# OUTPUTS_DIR=outputs

# API
API_HOST=0.0.0.0
API_PORT=8000

# Gradio
GRADIO_PORT=7860
GRADIO_SHARE=false
